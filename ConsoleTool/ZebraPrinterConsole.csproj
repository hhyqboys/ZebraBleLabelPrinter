<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>ZebraPrinterConsole</AssemblyName>
    <RootNamespace>ZebraPrinterConsole</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- 链接主项目源码，与 WPF 程序共用同一套打印逻辑 -->
    <Compile Include="..\Services\Code128Layout.cs" />
    <Compile Include="..\Services\ZebraPrinterService.cs" />
    <Compile Include="..\Helpers\RawPrinterHelper.cs" />
    <PackageReference Include="System.IO.Ports" Version="8.0.0" />
    <!-- 条码解码验证：把打印机实拍照片里的条码解码，验证打印质量/内容 -->
    <PackageReference Include="ZXing.Net" Version="0.16.9" />
  </ItemGroup>

</Project>
